{
  "group": "billing",
  "description": "billing 接口：catalog/account 免费响应、无商户密钥、设备列表",
  "cases": [
    {
      "id": "billing/catalog-empty",
      "tags": ["billing", "catalog"],
      "given": { "users": 1 },
      "steps": [
        { "op": "request", "call": "tokentracker-billing", "as": "owner",
          "query": { "action": "catalog" }, "method": "GET", "capture": ["status", "body"] }
      ]
    },
    {
      "id": "billing/account-default",
      "tags": ["billing", "account"],
      "given": { "users": 1 },
      "steps": [
        { "op": "request", "call": "tokentracker-billing", "as": "owner",
          "query": { "action": "account" }, "method": "GET", "capture": ["status", "body"] }
      ]
    },
    {
      "id": "billing/no-merchant-keys",
      "tags": ["billing", "L1", "security"],
      "given": { "users": 0 },
      "steps": [
        { "op": "query", "sql": "SELECT count(*)::int AS n FROM public.tokentracker_cloud_payment_providers WHERE enabled = true",
          "expectOptional": true, "capture": ["rows[0].n", "error"] }
      ]
    },
    {
      "id": "billing/unauthenticated",
      "tags": ["billing", "auth", "error"],
      "given": { "users": 0 },
      "steps": [
        { "op": "request", "call": "tokentracker-billing", "as": "anon",
          "query": { "action": "account" }, "method": "GET", "capture": ["status", "body"] }
      ]
    }
  ]
}
