{
  "group": "auth",
  "description": "认证边界：伪造/过期/未知 token、设备撤销、Go 应用层 owner isolation、账户级联删除",
  "cases": [
    {
      "id": "auth/forged-expired-unknown",
      "tags": ["auth", "error", "security"],
      "given": { "users": 1, "devices": 1, "usage": [100] },
      "steps": [
        { "op": "request", "call": "tokentracker-account-summary", "as": "forged",
          "query": { "from": "2026-10-01", "to": "2026-10-01" }, "capture": ["status", "body"] },
        { "op": "request", "call": "tokentracker-account-summary", "as": "expired",
          "query": { "from": "2026-10-01", "to": "2026-10-01" }, "capture": ["status", "body"] },
        { "op": "request", "call": "tokentracker-account-summary", "as": "anon",
          "query": { "from": "2026-10-01", "to": "2026-10-01" }, "capture": ["status", "body"] }
      ]
    },
    {
      "id": "auth/device-revocation",
      "tags": ["auth", "device", "billing"],
      "given": { "users": 1, "devices": 1 },
      "steps": [
        { "op": "request", "call": "tokentracker-billing", "as": "owner",
          "query": { "action": "remove-device" }, "body": { "machine_id": "@machineId:0" },
          "capture": ["status", "body"] },
        { "op": "request", "call": "tokentracker-ingest", "as": "device",
          "body": { "buckets": ["@usage:100"] }, "capture": ["status", "body"] }
      ]
    },
    {
      "id": "auth/rls-permission-matrix",
      "tags": ["auth", "security", "owner-isolation", "L2"],
      "given": { "users": 2, "devices": 1, "usage": [100] },
      "steps": [
        { "op": "request", "call": "tokentracker-account-summary", "as": "owner",
          "query": { "from": "2026-10-01", "to": "2026-10-01", "tz": "UTC" },
          "capture": ["status", "body.totals.total_tokens"] },
        { "op": "request", "call": "tokentracker-account-summary", "as": "stranger",
          "query": { "from": "2026-10-01", "to": "2026-10-01", "tz": "UTC", "user_id": "@ownerId" },
          "capture": ["status", "body.totals.total_tokens"] }
      ]
    },
    {
      "id": "auth/cascade-account-deletion",
      "tags": ["auth", "cascade"],
      "given": { "users": 1, "devices": 1 },
      "steps": [
        { "op": "deleteUser", "index": 0 },
        { "op": "query", "sql": "SELECT (SELECT count(*)::int FROM public.tokentracker_cloud_machines) AS machines, (SELECT count(*)::int FROM public.tokentracker_cloud_machine_aliases) AS aliases, (SELECT count(*)::int FROM public.tokentracker_devices) AS devices, (SELECT count(*)::int FROM public.tokentracker_hourly) AS hourly",
          "capture": ["rows[0]"] }
      ]
    }
  ]
}
