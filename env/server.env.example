# 服务端函数环境变量模板 —— 只提交占位符，绝不提交真实值。
# 用法：cp server.env.example server.env && chmod 600 server.env && 编辑填入真实值。
# server.env 已被 .gitignore 忽略。

# 自有 InsForge API 的公开地址（HTTPS）
INSFORGE_BASE_URL=https://api.your-domain.example

# 服务端专用凭据，绝不下发到浏览器
INSFORGE_SERVICE_ROLE_KEY=<server-only-service-credential>

# 公开匿名键（浏览器构建只用这个）
ANON_KEY=<public-anon-key>

# 平台签名密钥；RS256 平台改用 JWT_PUBLIC_KEY
JWT_SECRET=<platform-signing-secret>

# 必须指向你自己的 dashboard，HTTPS 或 loopback HTTP。
# 源码锚点校验会拒绝官方 dashboard 回落。
TOKENTRACKER_DASHBOARD_URL=https://dashboard.your-domain.example

TOKENTRACKER_BILLING_ENVIRONMENT=live

# 注意：自托管清单有意排除付费与赠送码功能，
# 不要配置 Waffo / Paddle / 微信 / 支付宝密钥。
# 官方 v2.3.3 平台会注入 INSFORGE_INTERNAL_URL / API_KEY 等内部别名，无需额外设置。
